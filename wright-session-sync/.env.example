# Copy this file to .env and fill in real values. Never commit .env.

# Teachworks
TEACHWORKS_API_KEY=
TEACHWORKS_BASE_URL=https://api.teachworks.com/v1

# Monday.com
MONDAY_API_TOKEN=

# Sync behavior (optional - defaults shown)
LOOKBACK_DAYS=3
FULL_SYNC_START_DATE=2020-01-01
REQUEST_TIMEOUT_SECONDS=30
MAX_RETRIES=5
RETRY_BASE_DELAY_SECONDS=1
