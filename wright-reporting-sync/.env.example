# Copy this file to .env and fill in real values. Never commit .env.

# Teachworks
TEACHWORKS_API_KEY=
TEACHWORKS_BASE_URL=https://api.teachworks.com/v1

# Monday.com (same token/account as wright-session-sync; different board)
MONDAY_API_TOKEN=

# --- Teachworks Reporting board (optional overrides -- defaults below are
# confirmed against the live board and already baked into sync_reporting.py.
# Only set these if the board or its columns are ever restructured.) ---
MONDAY_REPORTING_BOARD_ID=18432993218
MONDAY_REPORTING_COLUMN_SESSIONS_ATTENDED=numeric_mm7mrpe4
MONDAY_REPORTING_COLUMN_SESSIONS_MISSED=numeric_mm7mh4qd
MONDAY_REPORTING_COLUMN_TOTAL_SESSIONS=numeric_mm7me68f
MONDAY_REPORTING_COLUMN_STUDENTS_SERVED=numeric_mm7mhsf3
MONDAY_REPORTING_COLUMN_LAST_UPDATED=date_mm7m4799
MONDAY_REPORTING_COLUMN_AVG_SESSIONS_PER_STUDENT=numeric_mm7mg9ve
MONDAY_REPORTING_COLUMN_ATTENDED_AMOUNT=numeric_mm7mymrr
MONDAY_REPORTING_COLUMN_MISSED_AMOUNT=numeric_mm7m84fd
MONDAY_REPORTING_COLUMN_CANCELLED_AMOUNT=numeric_mm7m2mg5
MONDAY_REPORTING_COLUMN_SCHEDULED_AMOUNT=numeric_mm7m7y3x
MONDAY_REPORTING_COLUMN_TOTAL_AMOUNT=numeric_mm7mymtn

# Confirmed live: the board's year groups are titled exactly as the bare
# year (e.g. "2026"). Run `python sync_reporting.py --list-groups` to
# re-confirm before changing this.
MONDAY_REPORTING_YEAR_GROUP_TITLE_TEMPLATE={year}

# --- Everything below has a working default already confirmed for Wright
# Academics' Teachworks account; only set if Teachworks support says
# otherwise for your account. See audit.py's load_config() for the full list. ---
# TEACHWORKS_AUTH_HEADER=Authorization
# TEACHWORKS_AUTH_SCHEME=Token token={key}
